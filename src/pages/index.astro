<script>
  const sfxBgMusic = new Audio("/audio/snoopy-jazz-music.ogg");
  sfxBgMusic.loop = true; // Activa la reproducción en bucle
  sfxBgMusic.volume = 0.5; // Volumen al 50%

  const video = document.querySelector<HTMLVideoElement>("video.snoopy")!;
  const trigger = document.querySelector<HTMLElement>("div.screen")!;

  trigger.addEventListener("click", () => {
    video.play();
    sfxBgMusic.play();
    trigger.style.zIndex = "0";
    trigger.style.backgroundColor = "transparent";
  });


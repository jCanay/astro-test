<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    /* border: solid 1px red; */
  }

  body {
    font-family: Arial, sans-serif;
    background: #f4f4f4;
    margin: 0;
  }

  main {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  main section,
  main header {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 0 1rem;
  }

  main section > div.wrapper,
  main header > div.wrapper {
    width: 100%;
    max-width: 70rem;
  }
</style>

<style>
  .screen {
    /* display: none; */
    position: fixed;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f005;
    /* pointer-events: none; */
    cursor: pointer;
    z-index: 1;
  }

  video.snoopy {
    position: fixed;
    top: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .advent {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .house {
    position: relative;
    width: 80rem;
    translate: 0 -8rem;
    aspect-ratio: 1;
    z-index: -1;
  }

  .content {
    /* position: absolute; */
    width: fit-content;
    gap: 2rem;
    /* background-image: url("house2.svg"); */
    background-repeat: no-repeat;
    background-position: 50% 75%;
    background-size: 110rem;
    overflow: visible;
    display: flex;
    flex-direction: column;
  }

  header section {
    display: flex;
    flex-direction: column;
    align-items: center;

    justify-content: center;
    gap: 2rem;

    width: 100%;
    margin: 3rem 0;

    & h2 {
      font-size: 40pt;
      font-family: "Great Vibes", cursive;
      font-weight: 400;
      font-style: normal;
    }

    & time {
      font-size: xx-large;
      font-family: "Shantell Sans", cursive;
      font-optical-sizing: auto;
      font-weight: 600;
      font-style: italic;
    }
  }

  h1 {
    font-size: 2.5rem;
  }

  :global(header .wrapper) {
    background-color: #fff2;
    backdrop-filter: blur(10px);
    border-radius: 2rem;
    border: solid 2px #fff;
  }

  :global(.grid) {
    --max-cols: 6; /* Máximo absoluto de columnas */
    --gap: 2rem; /* Espacio entre columnas */
    --min-col-width: 100px; /* Ancho mínimo en móviles */
    --max-col-width: 100px; /* Tamaño deseado para cada tarjeta (.counter) */

    box-sizing: content-box;
    position: relative;
    display: grid;
    background-color: #fff2;
    border: solid 2px #fff;
    border-radius: 2rem;
    gap: var(--gap);
    padding: 2rem 2rem;
    width: 100%;
    margin-inline: auto;
    place-content: center;
    place-items: center;

    /* 1. Limita el crecimiento del contenedor al tamaño de tus tarjetas pequeñas */
    max-width: calc(
      (var(--max-cols) * var(--max-col-width)) + ((var(--max-cols) - 1) * var(--gap)) + 4rem
    );

    /* 2. Calcula el ancho mínimo porcentual para que nunca quepan más de 5 */
    --cols-limit: calc((100% - (var(--max-cols) - 1) * var(--gap)) / var(--max-cols) - 1px);

    /* 3. Usa el mayor entre el mínimo fijo (125px) y el límite de 5 columnas */
    grid-template-columns: repeat(
      auto-fill,
      minmax(max(min(100%, var(--min-col-width)), var(--cols-limit)), 1fr)
    );

    /* backdrop-filter: blur(10px); */

    &::before {
      content: "";
      backdrop-filter: blur(10px);
      border-radius: 2rem;
      width: 100%;
      height: 100%;
      position: absolute;
    }
  }

  :global(.counter) {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    border-radius: 1rem;
    height: 10rem;
    aspect-ratio: 1;
    background-color: rgb(245, 170, 170);
  }
</style>

<script>
  import { animate, createTimeline } from "animejs";

  const audioOpenChest = new Audio("/audio/zelda-chest-open-short.ogg");

  enum State {
    WAITING, // Esperando a que pueda ser desbloqueado
    LOCKED, // Bloqueado, aun no se puede abrir
    UNLOCKED, // Desbloqueado, pero aún no abierto
    OPENED, // Abierto, pero solo
    READY, //
  }
  const currentState = State.LOCKED;

  const locked = false;
  let opened = false;

  let mouseOverGift = false;

  const lid = document.querySelectorAll(".lid")[0];
  const h3 = document.querySelectorAll("h3")[0];
  const base = document.querySelectorAll(".base")[0];
  const article = document.querySelectorAll("article")[0];
  const note = document.querySelector<HTMLElement>(".note")!;

  if (opened) {
    lid.classList.add("animate");
    lid.getAnimations()[0].finish();

    h3.classList.add("hidden");
    h3.getAnimations()[0].finish();
  }

  const handleShake = (locked: boolean, opened: boolean) => {
    if (locked || opened) return;

    article.classList.add("shake");

    article.addEventListener("mouseenter", () => {
      mouseOverGift = true;
    });

    article.getAnimations()[0].addEventListener("finish", () => {
      if (mouseOverGift) article.getAnimations()[0].pause();
      else article.getAnimations()[0].play();
    });

    article.addEventListener("mouseleave", () => {
      mouseOverGift = false;
      article.getAnimations()[0].play();
    });
  };

  const handleLidOpening = () => {
    audioOpenChest.play();

    article.removeEventListener("mouseleave", () => {});
    article.removeEventListener("mouseenter", () => {});

    if (opened) return;

    note.style.pointerEvents = "none";

    const timeline = createTimeline()
      .add(
        ".note",
        {
          height: "100%",
          duration: 500,
          delay: 400,
          ease: "inOut",
          onComplete: () => {
            note.style.height = "100%";
          },
        },
        0,
      )
      .add(
        ".note",
        {
          top: "0%",
          duration: 700,
          delay: 400,
          ease: "inOutBack",
          onComplete: () => {
            note.style.top = "0%";
          },
        },
        0,
      )
      .add(".note", {
        translateY: "-65%",
        duration: 700,
        delay: 400,
        ease: "inOut",
        onComplete: () => {
          note.style.zIndex = "200";

          animate(".note", {
            translateY: "0%",
            duration: 750,
            delay: 250,
            ease: "inOutBack",
            onComplete: () => {
              note.style.pointerEvents = "all";
            },
          });
        },
      });

    timeline.play();

    h3.classList.add("hidden");

    article.getAnimations()[0].addEventListener("finish", () => {
      article.getAnimations()[0].pause();
      article.getAnimations()[0].cancel();
    });
    article.getAnimations()[0].removeEventListener("finish", () => {});
    // if (!lid.classList.contains("animate")) {

    lid.classList.add("animate");
    lid.getAnimations()[0].addEventListener("finish", () => {
      lid.classList.add("hide-events");
      base.classList.add("hide-events");
    });

    // lid.classList.remove("deanimate");
    // }
    // else {
    //   lid.classList.remove("animate");
    //   lid.classList.add("deanimate");
    // }

    base.removeEventListener("click", () => {});
    lid.removeEventListener("click", () => {});
    opened = true;
  };

  base.addEventListener("click", handleLidOpening);
  lid.addEventListener("click", handleLidOpening);
  handleShake(locked, opened);
</script>


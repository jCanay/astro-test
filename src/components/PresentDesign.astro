<style>
  section {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #0002;
    backdrop-filter: blur(10px);
  }

  .container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  h3 {
    top: -10rem;
    max-width: 200%;
    width: max-content;
    position: absolute;
    font-size: xx-large;
    text-align: center;

    &.hidden {
      animation: fade-out 500ms forwards;
    }
  }

  article {
    --bg-color: oklch(59.414% 0.17641 24.215);
    --wrap-color: oklch(69.786% 0.162 150.628);
    --w: clamp(200px, 100rem, 500px);
    position: relative;
    width: var(--w);
    aspect-ratio: 1;

    & * {
      /* border: solid 10px #0003; */
    }

    &.shake {
      animation: shake 1750ms forwards ease;
    }
  }

  .box {
    cursor: pointer;
    position: absolute;
    bottom: 0;

    width: var(--w);
    height: 90%;
    border-radius: 0 0 calc((var(--w) / 150px) * 1rem) calc((var(--w) / 150px) * 1rem);
    background-color: var(--bg-color);
    z-index: 20;

    &.wrapper {
      &::before {
        content: "";
        position: absolute;
        top: 45%;
        left: 0;
        translate: 0 -55%;
        width: 100%;
        height: calc((var(--w) / 10px) * 1px);
        background-color: var(--wrap-color);
      }

      &::after {
        content: "";
        position: absolute;
        top: 0;
        left: 50%;
        translate: -50%;
        height: 100%;
        width: calc((var(--w) / 10px) * 1px);
        background-color: var(--wrap-color);
      }
    }

    &.shadow {
      all: unset;
      position: absolute;
      bottom: 0;

      box-shadow: 0 0 100px 10px var(--bg-color);
      width: var(--w);
      height: 90%;
      border-radius: 0 0 calc((var(--w) / 150px) * 1rem) calc((var(--w) / 150px) * 1rem);
      /* background-color: var(--bg-color); */
      z-index: 0;
    }
  }

  .lid {
    cursor: pointer;
    position: absolute;
    top: 0;
    left: -2.5%;

    width: calc(var(--w) + 5%);
    height: 30%;
    border-radius: calc((var(--w) / 150px) * 1rem) calc((var(--w) / 150px) * 1rem) 0 0;
    background-color: var(--bg-color);
    z-index: 50;

    &::after {
      content: "";
      position: absolute;
      top: 0;
      left: 50%;
      translate: -50%;
      height: 100%;
      width: calc((var(--w) / 10px) * 1px);
      background-color: var(--wrap-color);
    }

    &.animate {
      animation: open-lid 500ms forwards;
    }

    &.deanimate {
      animation: close-lid 500ms forwards;
    }

    & svg {
      position: absolute;
      z-index: 50;
      width: 60%;
      left: 20%;
      top: -100%;
      border: 0;
    }
  }

  .note {
    background-color: #fff;
    position: absolute;
    top: 0;
    left: 10%;
    width: 80%;
    height: 100%;
    z-index: 10;
    /* z-index: 50; */
    transition: translate 200ms ease;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    text-align: center;
    padding: 2rem;

    & * {
      border: none;
    }

    &:hover {
      translate: 0 -25px;
      z-index: 15;
    }

    & h4 {
      margin-top: 1.25rem;
      font-size: 16pt;
    }
  }

  article:has(.note:hover) .lid {
    z-index: 10;
  }

  @keyframes shake {
    0%,
    40%,
    100% {
      rotate: 0deg;
    }

    5% {
      rotate: -2deg;
    }

    10% {
      rotate: 2deg;
    }

    15% {
      rotate: -2deg;
    }

    20% {
      rotate: 2deg;
    }

    25% {
      rotate: -1deg;
    }

    30% {
      rotate: 1deg;
    }

    35% {
      rotate: -0.5deg;
    }
  }

  @keyframes open-lid {
    from {
      translate: 0 0;
      rotate: 0deg;
      transform-origin: top left;
    }

    to {
      translate: -125px -25px;
      rotate: -30deg;
      transform-origin: top left;
    }
  }

  @keyframes close-lid {
    from {
      translate: -125px -25px;
      rotate: -30deg;
      transform-origin: top left;
    }

    to {
      translate: 0 0;
      rotate: 0deg;
      transform-origin: top left;
    }
  }

  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }
</style>
